# =====================================================================
#  PLANTILLA. Copiar como 01-secret.yaml y poner los valores REALES.
#  01-secret.yaml esta en el .gitignore: NUNCA se commitea.
#
#  stringData permite escribir los valores en texto plano;
#  Kubernetes los codifica a base64 automaticamente.
# =====================================================================
apiVersion: v1
kind: Secret
metadata:
  name: siderurgica-secrets
  namespace: siderurgica
type: Opaque
stringData:
  # --- Neon (PostgreSQL) ---
  DB_HOST: ep-wispy-bar-ap1s32ne-pooler.c-7.us-east-1.aws.neon.tech
  # UNA BASE DE DATOS POR MICROSERVICIO (no schemas compartidos)
  DB_NAME_AUTH: auth_db
  DB_NAME_VENTAS: ventas_db
  DB_NAME_INVENTARIO: inventario_db
  DB_USERNAME: neondb_owner
  DB_PASSWORD: PONER_LA_REAL

  # --- JWT: el MISMO en ms-auth y api-gateway ---
  JWT_SECRET: PONER_EL_MISMO_DEL_ENV

  # --- MySQL (ms-rrhh) ---
  MYSQL_ROOT_PASSWORD: root
  MYSQL_DATABASE: rrhh
  MYSQL_USER: rrhh_user
  MYSQL_PASSWORD: rrhh_pass
